# Uzywane WYLACZNIE przy lokalnym uruchamianiu Prisma CLI (migrate/studio)
# poza Dockerem. Wartosci musza byc spojne z glownym .env w katalogu
# nadrzednym (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB), ale host to
# "localhost", bo port 5432 kontenera postgres jest wystawiony na host.
DATABASE_URL="postgresql://rpg:change_me_in_production@localhost:5432/rpg_db?schema=public"
