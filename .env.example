POSTGRES_USER=rpg
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rpg_db

# Dwa osobne sekrety - kompromitacja access tokena (krotko zyjacego)
# nie pozwala podrobic dlugozyjacego refresh tokena, i odwrotnie.
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_access
JWT_REFRESH_SECRET=change_me_to_a_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
