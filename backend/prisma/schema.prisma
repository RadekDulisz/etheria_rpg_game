generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Obszar: User (etap projektowania ERD 1/N)
// ---------------------------------------------------------------------

enum Role {
  PLAYER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(PLAYER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Soft-delete pod wymog RODO (prawo do usuniecia konta bez utraty
  // integralnosci historii walk/gildii odwolujacych sie do usera).
  deletedAt       DateTime?

  character Character?

  @@map("users")
}

// ---------------------------------------------------------------------
// Obszar: Combatant (etap projektowania ERD 4/N)
//
// Refaktor po decyzji: bot ma korzystac z tych samych struktur co gracz
// (staty, ekwipunek, ekspertyza broni). Zamiast duplikowac te tabele
// osobno dla Character i osobno dla Bot, wprowadzono wspolny byt
// nadrzedny Combatant - to on jest "wlascicielem" statow, ekwipunku
// i ekspertyzy broni. Character i Bot to dwie rozne "fasady" nad
// Combatant (kazdy ma z nim relacje 1:1).
//
// Zaleta: silnik walki (etap 6) operuje wylacznie na Combatant, bez
// wiedzy, czy po drugiej stronie jest gracz czy bot - to samo w sobie
// dobry przyklad polimorfizmu/separacji odpowiedzialnosci do opisania
// w rozdziale o architekturze.
// ---------------------------------------------------------------------

enum CombatantType {
  PLAYER
  BOT
}

model Combatant {
  id   String        @id @default(uuid())
  type CombatantType

  character Character?
  bot       Bot?

  stats           CombatantStats?
  inventoryItems  InventoryItem[]
  ownedItems      OwnedItem[]
  gemStacks       GemStack[]
  equippedItems   EquippedItem[]
  weaponExpertise CombatantWeaponExpertise[]

  attackerBattles Battle[]      @relation("AttackerCombatant")
  defenderBattles Battle[]      @relation("DefenderCombatant")
  battleRounds    BattleRound[]

  @@map("combatants")
}

model Character {
  id              String    @id @default(uuid())
  combatantId     String    @unique
  combatant       Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String    @unique
  level           Int       @default(1)
  experience      BigInt    @default(0)
  gold            BigInt    @default(0)
  reputation      Int       @default(0)
  arenaRating     Int       @default(1000)
  arenaWins       Int       @default(0)
  arenaLosses     Int       @default(0)
  arenaDraws      Int       @default(0)
  currentHp       Int?
  healthUpdatedAt DateTime  @default(now())
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions     Transaction[]
  missionProgress  MissionProgress?
  missionAttempts  MissionAttempt[]
  ledGuild         Guild?                 @relation("GuildLeader")
  guildMembership  GuildMember?
  startedGuildWars GuildWar[]             @relation("GuildWarStarter")
  property         Property?
  forgeOperations  ForgeOperation[]
  marketRefreshes  MarketRefresh[]
  tavernBoard      TavernBoard?
  tavernQuestRuns  TavernQuestRun[]
  tavernChronicle  TavernChronicleEntry[]
  tavernProvisions TavernProvisionStack[]

  @@index([arenaRating(sort: Desc)])
  @@map("characters")
}

// Przeciwnik PvE, zarzadzany przez panel administracyjny (sekcja 3:
// "CRUD do zarzadzania... botami"). Korzysta z tych samych tabel
// CombatantStats/InventoryItem/EquippedItem co gracz.
model Bot {
  id          String    @id @default(uuid())
  combatantId String    @unique
  combatant   Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  name        String
  level       Int       @default(1)
  expReward   Int       @default(0)
  goldReward  Int       @default(0)
  reputation  Int       @default(0)
  // Pozwala administracji wylaczyc bota z puli przeciwnikow bez
  // usuwania go (i bez utraty historii walk, ktore sie do niego odwoluja).
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("bots")
}

model CombatantStats {
  combatantId   String    @id
  combatant     Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  strength      Int       @default(5)
  agility       Int       @default(5)
  endurance     Int       @default(5)
  intelligence  Int       @default(5)
  unspentPoints Int       @default(0)
  // Bazowa zdolnosc do parowania ciosow - trwaly staty, modyfikowany
  // dodatkowo przez parryBonus z zalozonego ekwipunku (patrz Item.parryBonus).
  parryRating   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@map("combatant_stats")
}

// ---------------------------------------------------------------------
// Obszar: Item + Inventory + EquippedItem (etap projektowania ERD 2/N)
// ---------------------------------------------------------------------

enum ItemCategory {
  WEAPON
  SHIELD_SIGIL
  ARMOR
  ACCESSORY
  SPECIAL
  CONSUMABLE
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

// Ranga wyposazenia wynikajaca z wymaganego poziomu. Progi odpowiadaja
// klasycznej progresji High Five, ale w interfejsie uzywamy polskiej nazwy.
enum ItemGrade {
  NO_GRADE
  D
  C
  B
  A
  S
  RUNIC
  ANCIENT
}

// Ogolny typ przedmiotu - okresla, do jakiej GRUPY slotow pasuje item.
// Rozne od EquipmentSlot: SlotGroup.RING moze trafic do EquipmentSlot.RING_1
// LUB EquipmentSlot.RING_2 - wybor konkretnej instancji naleznosci do gracza
// (walidowane w warstwie serwisu, nie na poziomie bazy danych).
enum SlotGroup {
  WEAPON
  SHIELD_SIGIL
  HELM
  UPPER_BODY
  LOWER_BODY
  GLOVES
  BOOTS
  CLOAK
  SHIRT
  NECKLACE
  EARRING
  RING
  BELT
  BRACELET
  BROOCH
  HAIR_ACCESSORY
}

// Konkretne, fizyczne sloty na postaci (18 slotow lacznie).
enum EquipmentSlot {
  WEAPON
  SHIELD_SIGIL
  HELM
  UPPER_BODY
  LOWER_BODY
  GLOVES
  BOOTS
  CLOAK
  SHIRT
  NECKLACE
  EARRING_1
  EARRING_2
  RING_1
  RING_2
  BELT
  BRACELET
  BROOCH
  HAIR_ACCESSORY
}

// Podzial broni na typy - kazdy typ ma niezaleznie rosnaca ekspertyze
// per Combatant (patrz CombatantWeaponExpertise). Tylko Item.category =
// WEAPON wypelnia to pole.
enum WeaponType {
  SWORD
  AXE
  DAGGER
  BOW
  BLUNT
  POLEARM
  STAFF
}

model Item {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  category    ItemCategory
  rarity      ItemRarity   @default(COMMON)
  grade       ItemGrade    @default(NO_GRADE)
  // Null dla konsumpcji (np. mikstury), wymagane dla ekwipunku.
  slotGroup   SlotGroup?
  // Wypelnione wylacznie gdy category = WEAPON.
  weaponType  WeaponType?
  // 1 dla nie-stackowalnego ekwipunku, >1 dla stackowalnych konsumpcji.
  maxStack    Int          @default(1)
  price       Int          @default(0)
  iconUrl     String?
  // Minimalny poziom postaci wymagany, zeby przedmiot byl widoczny/mozliwy
  // do kupienia w sklepie (patrz ShopEntry oraz obszar 6/N).
  minLevel    Int          @default(1)

  // Stale bonusy statystyk - decyzja: jeden przedmiot = jeden zestaw
  // statystyk (bez losowosci przy dropie).
  strengthBonus       Int @default(0)
  agilityBonus        Int @default(0)
  enduranceBonus      Int @default(0)
  intelligenceBonus   Int @default(0)
  attackPower         Int @default(0)
  // Zakres bazowych obrazen broni. attackPower pozostaje wartoscia
  // posrednia dla kompatybilnosci panelu administracyjnego.
  damageMin           Int @default(0)
  damageMax           Int @default(0)
  defensePower        Int @default(0)
  // Bonus do CombatantStats.parryRating - typowo > 0 dla tarcz/sigili.
  parryBonus          Int @default(0)
  maxHpBonus          Int @default(0)
  // Ocena trafienia krytycznego. Silnik walki przelicza ją na procent
  // z malejącą wagą, razem z DEX oraz biegłością w używanej broni.
  criticalChanceBonus Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryEntries  InventoryItem[]
  ownedEntries      OwnedItem[]
  shopEntries       ShopEntry[]
  missionRewards    MissionAttempt[]
  tavernRewards     TavernQuestRun[]       @relation("TavernRandomReward")
  tavernStoryRelics TavernQuestRun[]       @relation("TavernStoryRelic")
  tavernChronicles  TavernChronicleEntry[]

  @@map("items")
}

// Ekwipunek - stackowalne wiersze (1 wiersz = 1 typ przedmiotu + ilosc).
// Nalezy do Combatant (dziala identycznie dla gracza i bota).
model InventoryItem {
  id          String    @id @default(uuid())
  combatantId String
  combatant   Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([combatantId, itemId])
  @@map("inventory_items")
}

// Konkretny egzemplarz wyposazenia. W przeciwienstwie do katalogowego Item
// przechowuje stan zmienny: poziom ulepszenia oraz gniazda. Dwie sztuki tego
// samego Item pozostaja dzieki temu niezalezne.
model OwnedItem {
  id               String    @id @default(uuid())
  combatantId      String
  combatant        Combatant @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item      @relation(fields: [itemId], references: [id])
  enhancementLevel Int       @default(0)
  socketCapacity   Int       @default(0)
  unlockedSockets  Int       @default(0)
  forgeFailStack   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  equippedEntry   EquippedItem?
  sockets         ItemSocket[]
  forgeOperations ForgeOperation[]

  @@index([combatantId, createdAt])
  @@index([itemId])
  @@map("owned_items")
}

// Zalozony przedmiot w konkretnym, fizycznym slocie. PK zlozony
// (combatantId, slot) gwarantuje jeden przedmiot na slot naraz.
model EquippedItem {
  combatantId String
  combatant   Combatant     @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  slot        EquipmentSlot
  ownedItemId String        @unique
  ownedItem   OwnedItem     @relation(fields: [ownedItemId], references: [id], onDelete: Cascade)
  equippedAt  DateTime      @default(now())

  @@id([combatantId, slot])
  @@map("equipped_items")
}

enum GemFamily {
  RUBY
  AMETHYST
  EMERALD
  SAPPHIRE
}

enum GemTier {
  SHARD
  CUT
  FLAWLESS
  ROYAL
  ANCIENT
}

model GemDefinition {
  id        String    @id @default(uuid())
  family    GemFamily
  tier      GemTier
  name      String    @unique
  minLevel  Int
  iconUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stacks         GemStack[]
  sockets        ItemSocket[]
  missionRewards MissionAttempt[]
  tavernRewards  TavernQuestRun[]

  @@unique([family, tier])
  @@map("gem_definitions")
}

model GemStack {
  combatantId     String
  combatant       Combatant     @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  gemDefinitionId String
  gemDefinition   GemDefinition @relation(fields: [gemDefinitionId], references: [id], onDelete: Cascade)
  quantity        Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@id([combatantId, gemDefinitionId])
  @@map("gem_stacks")
}

model ItemSocket {
  ownedItemId     String
  ownedItem       OwnedItem      @relation(fields: [ownedItemId], references: [id], onDelete: Cascade)
  position        Int
  gemDefinitionId String?
  gemDefinition   GemDefinition? @relation(fields: [gemDefinitionId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@id([ownedItemId, position])
  @@index([gemDefinitionId])
  @@map("item_sockets")
}

enum ForgeOperationType {
  UPGRADE
  SOCKET_UNLOCK
  GEM_INSERT
}

enum ForgeOperationResult {
  SUCCESS
  FAILURE
}

model ForgeOperation {
  id          String               @id @default(uuid())
  characterId String
  character   Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  ownedItemId String
  ownedItem   OwnedItem            @relation(fields: [ownedItemId], references: [id], onDelete: Cascade)
  type        ForgeOperationType
  result      ForgeOperationResult
  goldCost    BigInt               @default(0)
  fromLevel   Int?
  toLevel     Int?
  createdAt   DateTime             @default(now())

  @@index([characterId, createdAt])
  @@index([ownedItemId, createdAt])
  @@map("forge_operations")
}

// ---------------------------------------------------------------------
// Obszar: CombatantWeaponExpertise (etap projektowania ERD 3/N)
// Zdecydowano: brak systemu umiejetnosci (Skill/CharacterSkill) na tym
// etapie - autoattack oparty o staty, ekwipunek i ekspertyze broni.
// ---------------------------------------------------------------------

model CombatantWeaponExpertise {
  combatantId String
  combatant   Combatant  @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  weaponType  WeaponType
  experience  Int        @default(0)
  level       Int        @default(1)
  updatedAt   DateTime   @updatedAt

  @@id([combatantId, weaponType])
  @@map("combatant_weapon_expertise")
}

// ---------------------------------------------------------------------
// Obszar: Battle + BattleRound (etap projektowania ERD 5/N)
//
// Decyzje: PvP asynchroniczne (atak rozstrzygany natychmiast, obronca
// nie musi byc online); log walki jako osobna, relacyjna tabela
// BattleRound (runda po rundzie), zamiast kolumny JSON.
// ---------------------------------------------------------------------

enum BattleType {
  PVE
  PVP
}

enum BattleResult {
  ATTACKER_WIN
  DEFENDER_WIN
  DRAW
}

enum BattleActionType {
  HIT
  CRITICAL_HIT
  MISS
  PARRIED
}

// Pojedyncze starcie - rozstrzygane natychmiast, jednym obliczeniem
// (silnik walki, etap 6), niezaleznie od tego czy defender jest online.
model Battle {
  id         String       @id @default(uuid())
  type       BattleType
  attackerId String
  attacker   Combatant    @relation("AttackerCombatant", fields: [attackerId], references: [id])
  defenderId String
  defender   Combatant    @relation("DefenderCombatant", fields: [defenderId], references: [id])
  result     BattleResult
  expReward  Int          @default(0)
  goldReward Int          @default(0)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  rounds BattleRound[]

  @@map("battles")
}

// Pojedyncza runda/wymiana ciosow w ramach walki - relacyjny log,
// pozwala latwo analizowac statystyki (np. sredni % trafien krytycznych)
// bez parsowania JSON-a.
model BattleRound {
  id            String           @id @default(uuid())
  battleId      String
  battle        Battle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  roundNumber   Int
  actorId       String
  actor         Combatant        @relation(fields: [actorId], references: [id])
  actionType    BattleActionType
  damageDealt   Int              @default(0)
  actorHpAfter  Int?
  targetHpAfter Int?

  @@unique([battleId, roundNumber, actorId])
  @@map("battle_rounds")
}

// ---------------------------------------------------------------------
// Obszar: Transaction + ShopEntry (etap projektowania ERD 6/N)
//
// Decyzje: sklep ma codziennie inna, losowo dobierana pule przedmiotow
// (ShopEntry generowany przez zadanie cykliczne - poza zakresem ERD,
// implementacja w warstwie serwisu/CRON). Przedmioty odblokowuja sie
// dla gracza wg Item.minLevel vs Character.level. Kazda zmiana zlota
// (zakup, nagroda za walke, w przyszlosci: misje, wojny gildii) trafia
// do Transaction jako trwaly log audytowy.
// ---------------------------------------------------------------------

enum TransactionType {
  SHOP_PURCHASE
  BATTLE_REWARD
  QUEST_REWARD
  GUILD_WAR_REWARD
  PROPERTY_PURCHASE
  PROPERTY_UPGRADE
  PROPERTY_INCOME
  PROPERTY_RESTORATION
  ADMIN_ADJUSTMENT
  ITEM_SALE
  BLACKSMITH_UPGRADE
  BLACKSMITH_SOCKET_UNLOCK
  BLACKSMITH_GEM_INSERT
  JEWELER_GEM_COMBINE
  JEWELER_GEM_EXTRACT
  MARKET_REFRESH
  TAVERN_REFRESH
  TAVERN_PROVISION_PURCHASE
}

enum TavernQuestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TavernQuestStatus {
  ACTIVE
  RESOLVED
  CLAIMED
}

enum TavernChoiceAlignment {
  GOOD
  NEUTRAL
  EVIL
}

enum TavernProvisionType {
  HEALING_POTION
  TRAVEL_BANDAGE
  VAEL_ANTIDOTE
}

enum MissionResult {
  SUCCESS
  FAILURE
}

enum MissionMorality {
  GOOD
  EVIL
}

model MissionProgress {
  characterId           String    @id
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  totalMissions         Int       @default(0)
  missionsSinceTierFive Int       @default(0)
  updatedAt             DateTime  @updatedAt

  @@map("mission_progress")
}

model MissionAttempt {
  id                    String           @id @default(uuid())
  characterId           String
  character             Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tier                  Int
  title                 String
  description           String
  outcomeText           String
  result                MissionResult
  morality              MissionMorality?
  choiceTitle           String?
  choiceDescription     String?
  reputationChange      Int              @default(0)
  goldReward            BigInt           @default(0)
  experienceReward      BigInt           @default(0)
  hpLost                Int
  rewardItemId          String?
  rewardItem            Item?            @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)
  rewardGemDefinitionId String?
  rewardGemDefinition   GemDefinition?   @relation(fields: [rewardGemDefinitionId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())

  @@index([characterId, createdAt])
  @@index([rewardGemDefinitionId])
  @@map("mission_attempts")
}

model TavernBoard {
  id           String        @id @default(uuid())
  characterId  String        @unique
  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  refreshDate  DateTime      @db.Date
  refreshCount Int           @default(0)
  generatedAt  DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  offers       TavernOffer[]

  @@map("tavern_boards")
}

model TavernOffer {
  id               String                @id @default(uuid())
  boardId          String
  board            TavernBoard           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateKey      String
  difficulty       TavernQuestDifficulty
  title            String
  region           String
  summary          String
  stageCount       Int
  recommendedLevel Int
  encounterSummary String
  goldMin          Int
  goldMax          Int
  experienceMin    BigInt
  experienceMax    BigInt
  itemChance       Float
  gemChance        Float
  hpRiskMinPercent Int
  hpRiskMaxPercent Int
  createdAt        DateTime              @default(now())

  @@index([boardId, difficulty])
  @@map("tavern_offers")
}

model TavernQuestRun {
  id                    String                 @id @default(uuid())
  characterId           String
  character             Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  templateKey           String
  difficulty            TavernQuestDifficulty
  title                 String
  region                String
  summary               String
  stageIndex            Int                    @default(0)
  stageCount            Int
  score                 Int                    @default(0)
  status                TavernQuestStatus      @default(ACTIVE)
  result                MissionResult?
  goldMin               Int
  goldMax               Int
  experienceMin         BigInt
  experienceMax         BigInt
  itemChance            Float
  gemChance             Float
  hpRiskMinPercent      Int
  hpRiskMaxPercent      Int
  goldReward            BigInt                 @default(0)
  experienceReward      BigInt                 @default(0)
  reputationChange      Int                    @default(0)
  hpLost                Int                    @default(0)
  startingHp            Int                    @default(1)
  journeyHp             Int                    @default(1)
  maxHpSnapshot         Int                    @default(1)
  rewardItemId          String?
  rewardItem            Item?                  @relation("TavernRandomReward", fields: [rewardItemId], references: [id], onDelete: SetNull)
  storyRelicItemId      String?
  storyRelicItem        Item?                  @relation("TavernStoryRelic", fields: [storyRelicItemId], references: [id], onDelete: SetNull)
  storyRelicAwarded     Boolean                @default(false)
  rewardGemDefinitionId String?
  rewardGemDefinition   GemDefinition?         @relation(fields: [rewardGemDefinitionId], references: [id], onDelete: SetNull)
  endingTitle           String?
  endingText            String?
  endingKey             String?
  startedAt             DateTime               @default(now())
  resolvedAt            DateTime?
  claimedAt             DateTime?
  decisions             TavernQuestDecision[]
  provisions            TavernQuestProvision[]
  encounters            TavernQuestEncounter[]
  puzzles               TavernQuestPuzzle[]

  @@index([characterId, status])
  @@index([characterId, startedAt])
  @@index([rewardItemId])
  @@index([storyRelicItemId])
  @@index([rewardGemDefinitionId])
  @@map("tavern_quest_runs")
}

model TavernChronicleEntry {
  id               String                  @id @default(uuid())
  characterId      String
  character        Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  templateKey      String
  title            String
  region           String
  completions      Int                     @default(0)
  successes        Int                     @default(0)
  failures         Int                     @default(0)
  bestScore        Int                     @default(-999)
  bestEndingKey    String?
  bestEndingTitle  String?
  relicClaimed     Boolean                 @default(false)
  relicItemId      String?
  relicItem        Item?                   @relation(fields: [relicItemId], references: [id], onDelete: SetNull)
  firstCompletedAt DateTime                @default(now())
  lastCompletedAt  DateTime                @default(now())
  endings          TavernChronicleEnding[]

  @@unique([characterId, templateKey])
  @@index([characterId, lastCompletedAt(sort: Desc)])
  @@index([relicItemId])
  @@map("tavern_chronicle_entries")
}

model TavernChronicleEnding {
  id                String               @id @default(uuid())
  chronicleEntryId  String
  chronicleEntry    TavernChronicleEntry @relation(fields: [chronicleEntryId], references: [id], onDelete: Cascade)
  endingKey         String
  endingTitle       String
  timesReached      Int                  @default(1)
  bestScore         Int
  firstDiscoveredAt DateTime             @default(now())
  lastReachedAt     DateTime             @default(now())

  @@unique([chronicleEntryId, endingKey])
  @@index([chronicleEntryId, firstDiscoveredAt])
  @@map("tavern_chronicle_endings")
}

model TavernQuestPuzzle {
  id             String         @id @default(uuid())
  runId          String
  run            TavernQuestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stageIndex     Int
  puzzleKey      String
  attempts       Int            @default(0)
  maxAttempts    Int            @default(2)
  solved         Boolean?
  selectedAnswer Json?
  scoreDelta     Int            @default(0)
  outcomeText    String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@unique([runId, stageIndex])
  @@index([runId, createdAt])
  @@map("tavern_quest_puzzles")
}

model TavernQuestEncounter {
  id                   String         @id @default(uuid())
  runId                String
  run                  TavernQuestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stageIndex           Int
  enemyKey             String
  enemyName            String
  enemyTitle           String
  enemyKind            String
  enemyLevel           Int
  enemyIllustrationUrl String
  enemyMaxHp           Int
  playerHpBefore       Int
  playerHpAfter        Int
  enemyHpAfter         Int
  result               BattleResult
  scoreDelta           Int
  rounds               Json
  createdAt            DateTime       @default(now())

  @@unique([runId, stageIndex])
  @@index([runId, createdAt])
  @@map("tavern_quest_encounters")
}

model TavernProvisionStack {
  characterId String
  character   Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        TavernProvisionType
  quantity    Int                 @default(0)
  updatedAt   DateTime            @updatedAt

  @@id([characterId, type])
  @@map("tavern_provision_stacks")
}

model TavernQuestProvision {
  runId           String
  run             TavernQuestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  type            TavernProvisionType
  initialQuantity Int
  remaining       Int
  used            Int                 @default(0)

  @@id([runId, type])
  @@map("tavern_quest_provisions")
}

model TavernQuestDecision {
  id              String                @id @default(uuid())
  runId           String
  run             TavernQuestRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  stageIndex      Int
  choiceId        String
  choiceTitle     String
  alignment       TavernChoiceAlignment
  attribute       String
  roll            Int
  target          Int
  succeeded       Boolean
  scoreDelta      Int
  reputationDelta Int
  outcomeText     String
  createdAt       DateTime              @default(now())

  @@unique([runId, stageIndex])
  @@index([runId, createdAt])
  @@map("tavern_quest_decisions")
}

enum GuildMemberRole {
  LEADER
  MEMBER
}

enum GuildWarStatus {
  ACTIVE
  FINISHED
}

// Log kazdej zmiany zlota postaci - niezmienny (append-only), niezalezny
// od tego, czy encja, do ktorej sie odnosi (Battle, ShopEntry...) nadal
// istnieje. Celowo BEZ twardego klucza obcego w referenceId - to
// polimorficzne odniesienie (raz do Battle.id, raz do ShopEntry.id),
// a dla logu audytowego waznniejsza jest trwalosc wpisu niz
// referencyjna integralnosc do zrodla (opisac jako swiadomy kompromis
// w rozdziale o modelu danych).
model Transaction {
  id           String          @id @default(uuid())
  characterId  String
  character    Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type         TransactionType
  // Dodatnie = przychod (nagroda), ujemne = wydatek (zakup).
  amount       BigInt
  // Stan zlota PO tej transakcji - denormalizacja ulatwiajaca audyt
  // bez przeliczania calej historii od zera.
  balanceAfter BigInt
  // Luzne odniesienie do zrodla transakcji (np. Battle.id, ShopEntry.id) -
  // patrz komentarz nad modelem.
  referenceId  String?
  description  String?
  createdAt    DateTime        @default(now())

  @@index([characterId, createdAt])
  @@map("transactions")
}

// Codzienna oferta sklepu - jeden wiersz = jeden przedmiot dostepny
// danego dnia. Generowane przez zadanie cykliczne (CRON), poza zakresem
// modelu danych. Widocznosc/mozliwosc zakupu przez konkretna postac
// zalezy dodatkowo od Item.minLevel <= Character.level (walidowane w
// warstwie serwisu przy GET listy ofert i przy POST zakupu).
model ShopEntry {
  id              String         @id @default(uuid())
  itemId          String
  item            Item           @relation(fields: [itemId], references: [id])
  // Dzien, w ktorym oferta jest aktywna (bez czesci czasowej).
  offerDate       DateTime       @db.Date
  // Null = cena rowna Item.price; wypelnione = promocja/inna cena danego dnia.
  priceOverride   Int?
  // Wylosowany procent rabatu; przechowywany dla wiernego wyswietlania
  // oferty i audytu niezaleznie od zaokraglenia ceny.
  discountPercent Int?
  // Null = bez limitu ilosciowego danego dnia.
  stockLimit      Int?
  quantitySold    Int            @default(0)
  marketRefreshId String?
  marketRefresh   MarketRefresh? @relation(fields: [marketRefreshId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([itemId, offerDate])
  @@index([marketRefreshId])
  @@map("shop_entries")
}

model MarketRefresh {
  id           String      @id @default(uuid())
  characterId  String
  character    Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  offerDate    DateTime    @db.Date
  refreshCount Int         @default(0)
  shopEntries  ShopEntry[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([characterId, offerDate])
  @@map("market_refreshes")
}

// Podstawowa gildia: nazwa, opis i lider powiazany z postacia gracza.
model Guild {
  id                String        @id @default(uuid())
  name              String        @unique
  description       String?
  leaderCharacterId String        @unique
  leaderCharacter   Character     @relation("GuildLeader", fields: [leaderCharacterId], references: [id], onDelete: Restrict)
  members           GuildMember[]
  warsAsAttacker    GuildWar[]    @relation("GuildWarAttacker")
  warsAsDefender    GuildWar[]    @relation("GuildWarDefender")
  wonWars           GuildWar[]    @relation("GuildWarWinner")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("guilds")
}

// Czlonkostwo w gildii - jedna postac moze nalezec do najwyzej jednej gildii.
model GuildMember {
  id          String          @id @default(uuid())
  guildId     String
  guild       Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characterId String          @unique
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        GuildMemberRole @default(MEMBER)
  joinedAt    DateTime        @default(now())

  @@index([guildId])
  @@map("guild_members")
}

// Wojna gildii - zapis walki dwoch gildii z mozliwoscia wskazania
// zwyciezcy i zamkniecia starcia w historii.
model GuildWar {
  id                   String         @id @default(uuid())
  attackerGuildId      String
  attackerGuild        Guild          @relation("GuildWarAttacker", fields: [attackerGuildId], references: [id], onDelete: Cascade)
  defenderGuildId      String
  defenderGuild        Guild          @relation("GuildWarDefender", fields: [defenderGuildId], references: [id], onDelete: Cascade)
  startedByCharacterId String
  startedByCharacter   Character      @relation("GuildWarStarter", fields: [startedByCharacterId], references: [id], onDelete: Restrict)
  winnerGuildId        String?
  winnerGuild          Guild?         @relation("GuildWarWinner", fields: [winnerGuildId], references: [id], onDelete: SetNull)
  status               GuildWarStatus @default(ACTIVE)
  summary              String?
  startedAt            DateTime       @default(now())
  finishedAt           DateTime?

  @@index([status, startedAt])
  @@index([attackerGuildId, defenderGuildId])
  @@map("guild_wars")
}

// Posiadlosc gracza - jeden gospodarczy byt na jedna postac, z poziomem
// rozbudowy i akumulowanym dochodem dziennym do odebrania recznie.
model Property {
  id              String    @id @default(uuid())
  characterId     String    @unique
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  level           Int       @default(1)
  baseIncome      Int       @default(100)
  lastCollectedAt DateTime  @default(now())
  lastRestoredAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  upgrades PropertyUpgrade[]

  @@index([level])
  @@map("properties")
}

// Historia rozbudowy posiadlosci - kazdy upgrade zapisuje nowy poziom,
// koszt i wartosc dochodu po ulepszeniu.
model PropertyUpgrade {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromLevel   Int
  toLevel     Int
  goldCost    Int
  incomeAfter Int
  upgradedAt  DateTime @default(now())

  @@index([propertyId, upgradedAt])
  @@map("property_upgrades")
}
